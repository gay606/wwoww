        setFling(not features.fling)
        for _, child in ipairs(container:GetDescendants()) do
            if child:IsA("TextButton") and child.Parent then
                local label = child.Parent:FindFirstChildWhichIsA("TextLabel")
                if label and label.Text == "NÉN XA" then
                    child.MouseButton1Click:Fire()
                    break
                end
            end
        end
    elseif key == Enum.KeyCode.R then
        setSpeed(not features.speed)
        for _, child in ipairs(container:GetDescendants()) do
            if child:IsA("TextButton") and child.Parent then
                local label = child.Parent:FindFirstChildWhichIsA("TextLabel")
                if label and label.Text == "CHẠY NHANH" then
                    child.MouseButton1Click:Fire()
                    break
                end
            end
        end
    end
end)
