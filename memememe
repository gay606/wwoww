local function getPlayersInCircle()
    local char = player.Character
    if not char then return {} end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return {} end
    local myPos = rootPart.Position
    local radius = circleSize / 3.5
    local targets = {}
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            local otherChar = other.Character
            if otherChar then
                local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
                if otherRoot then
                    local dist = (otherRoot.Position - myPos).Magnitude
                    if dist <= radius then
                        table.insert(targets, {Player = other, Root = otherRoot, Distance = dist})
                    end
                end
            end
        end
    end
    table.sort(targets, function(a,b) return a.Distance < b.Distance end)
    return targets
end

-- === AIM ===
local function startAim()
    if connections.aim then return end
    aimCircle.Visible = true
    connections.aim = RunService.Heartbeat:Connect(function()
        if not features.aim then
            aimCircle.Visible = false
            return
        end
        local targets = getPlayersInCircle()
        if #targets > 0 then
            local target = targets[1]
            local root = target.Root
            if root then
                local myChar = player.Character
                if myChar and myChar:FindFirstChild("Head") then
                    local head = myChar.Head
                    local direction = (root.Position - head.Position).Unit
                    local lookAt = head.Position + direction * 100
                    camera.CFrame = CFrame.lookAt(camera.CFrame.Position, lookAt)
                end
            end
            aimCircle.BorderColor3 = Color3.fromRGB(0,255,0)
        else
            aimCircle.BorderColor3 = Color3.fromRGB(255,0,0)
        end
    end)
end

local function stopAim()
    if connections.aim then
        connections.aim:Disconnect()
        connections.aim = nil
    end
    aimCircle.Visible = false
end

-- === FLING ===
local function startFling()
    if connections.fling then return end
    connections.fling = RunService.Heartbeat:Connect(function()
        if not features.fling then return end
        local myChar = player.Character
        if not myChar then return end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        local myPos = myRoot.Position

        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= player then
                local otherChar = other.Character
                if otherChar then
                    local root = otherChar:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - myPos).Magnitude
                        if dist < 50 then
                            local dir = (root.Position - myPos).Unit
                            local force = dir * Vector3.new(math.random(400,800), math.random(300,600), math.random(400,800))
                            root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + force
                        end
                    end
                end
            end
        end
    end)
end

local function stopFling()
    if connections.fling then
        connections.fling:Disconnect()
        connections.fling = nil
    end
end

-- === SPEED ===
local function startSpeed()
    if connections.speed then return end
    connections.speed = RunService.Heartbeat:Connect(function()
        if not features.speed then return end
        local char = player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                hum.WalkSpeed = 80
                hum.JumpPower = 80
            end
        end
    end)
end

local function stopSpeed()
    if connections.speed then
        connections.speed:Disconnect()
        connections.speed = nil
    end
    local char = player.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.WalkSpeed = 16
            hum.JumpPower = 50
        end
    end
end

-- === Các hàm bật/tắt chung ===
local function setESP(state)
    features.esp = state
    if not state then
        for _, data in pairs(espObjects) do
            data.Name.Visible = false
            data.Box.Visible = false
            data.Dist.Visible = false
        end
    end
end
local function setAim(state)
    features.aim = state
    if state then startAim() else stopAim() end
end
local function setFling(state)
    features.fling = state
    if state then startFling() else stopFling() end
end
local function setSpeed(state)
    features.speed = state
    if state then startSpeed() else stopSpeed() end
end

