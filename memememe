-- === ESP ===
local function createESP(otherPlayer)
    if espObjects[otherPlayer] then return end
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(0, 100, 0, 14)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = otherPlayer.Name
    nameLabel.TextColor3 = Color3.fromRGB(255,255,255)
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = ScreenGui

    local box = Instance.new("Frame")
    box.Size = UDim2.new(0, 30, 0, 60)
    box.BackgroundTransparency = 0.5
    box.BackgroundColor3 = Color3.fromRGB(255,0,0)
    box.BorderSizePixel = 2
    box.BorderColor3 = Color3.fromRGB(0,255,0)
    box.Parent = ScreenGui

    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(0, 50, 0, 12)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = "0s"
    distLabel.TextColor3 = Color3.fromRGB(255,255,0)
    distLabel.TextScaled = true
    distLabel.Font = Enum.Font.Gotham
    distLabel.Parent = ScreenGui

    espObjects[otherPlayer] = {Name = nameLabel, Box = box, Dist = distLabel}
end

local function removeESP(otherPlayer)
    local data = espObjects[otherPlayer]
    if data then
        data.Name:Destroy()
        data.Box:Destroy()
        data.Dist:Destroy()
        espObjects[otherPlayer] = nil
    end
end
Players.PlayerRemoving:Connect(removeESP)

local function updateESP()
    for _, data in pairs(espObjects) do
        data.Name.Visible = false
        data.Box.Visible = false
        data.Dist.Visible = false
    end
    if not features.esp then return end

    local myChar = player.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            local otherChar = other.Character
            if otherChar then
                local root = otherChar:FindFirstChild("HumanoidRootPart")
                local head = otherChar:FindFirstChild("Head")
                if root and head then
                    if not espObjects[other] then createESP(other) end
                    local pos, onScreen = camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        local esp = espObjects[other]
                        esp.Name.Visible = true
                        esp.Box.Visible = true
                        esp.Dist.Visible = true
                        esp.Name.Position = UDim2.new(0, pos.X - 50, 0, pos.Y - 50)
                        local size = (head.Position - root.Position).Magnitude * 1.5
                        esp.Box.Size = UDim2.new(0, size * 0.6, 0, size * 1.2)
                        esp.Box.Position = UDim2.new(0, pos.X - size * 0.3, 0, pos.Y - size * 1.1)
                        local dist = (root.Position - myRoot.Position).Magnitude
                        esp.Dist.Text = string.format("%.0f", dist)
                        esp.Dist.Position = UDim2.new(0, pos.X - 25, 0, pos.Y + 20)
                        local color = Color3.fromHSV(math.clamp(dist / 100, 0, 1), 1, 1)
                        esp.Box.BorderColor3 = color
                    end
                end
            end
        end
    end
end

